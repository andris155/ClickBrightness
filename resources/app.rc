#include <windows.h>
#include "resource.h"

IDI_APP_ICON    ICON "program.ico"
IDI_SUN_DEFAULT ICON "sun.ico"
IDI_SUN_DARK    ICON "sun-dark.ico"
IDI_SUN_BLACK   ICON "sun-black.ico"
IDI_SUN_WHITE   ICON "sun-white.ico"
IDI_SUN_RED     ICON "sun-red.ico"
IDI_SUN_ORANGE  ICON "sun-orange.ico"
IDI_SUN_GREEN   ICON "sun-green.ico"
IDI_SUN_TEAL    ICON "sun-teal.ico"
IDI_SUN_BLUE    ICON "sun-blue.ico"
IDI_SUN_PURPLE  ICON "sun-purple.ico"
IDI_SUN_PINK    ICON "sun-pink.ico"
IDI_SUN_GRAY    ICON "sun-gray.ico"


// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "andris155"
            VALUE "FileDescription",  "ClickBrightness"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "InternalName",     "ClickBrightness"
            VALUE "OriginalFilename", "ClickBrightness.exe"
            VALUE "ProductName",      "ClickBrightness"
            VALUE "ProductVersion",   "v2.0.0"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
