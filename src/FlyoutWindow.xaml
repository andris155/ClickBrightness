<Window
    x:Class="BrightnessApp.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BrightnessApp">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.ChildrenTransitions>
            <TransitionCollection/>
        </Grid.ChildrenTransitions>
        <Border x:Name="ContainerBorder"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="8"
                Padding="12,10,12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock x:Name="TitleText"
                           Grid.Row="0"
                           Text="Brightness 50%"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12"
                           FontWeight="Normal"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Width="96"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,10"
                           HorizontalAlignment="Center"/>

                <!-- Content Grid: 3 columns (Buttons, Main Slider, Extra Sync Sliders), 2 rows (Headers, Controls) -->
                <Grid Grid.Row="1" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0, Column 1: Main Slider Header (multi-sync mode only) -->
                    <TextBlock x:Name="MainColumnHeader"
                               Grid.Row="0"
                               Grid.Column="1"
                               Visibility="Collapsed"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="12"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Width="64"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Margin="-9,0,0,8"
                               HorizontalAlignment="Left"/>

                    <!-- Row 0, Column 2: Additional Sync-Mode Monitor Headers -->
                    <StackPanel x:Name="SyncHeadersPanel"
                                Grid.Row="0"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="Collapsed"
                                Margin="6,0,0,8"
                                VerticalAlignment="Top"/>

                    <!-- Row 1, Column 0: 21 Preset Buttons -->
                    <StackPanel x:Name="ButtonStack"
                                Grid.Row="1"
                                Grid.Column="0"
                                Spacing="2"
                                VerticalAlignment="Top">
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection/>
                        </StackPanel.ChildrenTransitions>
                    </StackPanel>

                    <!-- Row 1, Column 1: Native WinUI 3 Slider -->
                    <Slider x:Name="BrightnessSlider"
                            Grid.Row="1"
                            Grid.Column="1"
                            Orientation="Vertical"
                            Minimum="0"
                            Maximum="100"
                            StepFrequency="1"
                            SmallChange="1"
                            LargeChange="5"
                            Height="502"
                            Margin="7,0,0,0"
                            IsThumbToolTipEnabled="True"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left"/>

                    <!-- Row 1, Column 2: Additional Sync-Mode Monitor Sliders -->
                    <StackPanel x:Name="SyncMonitorsPanel"
                                Grid.Row="1"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="Collapsed"
                                Margin="6,0,0,0"
                                VerticalAlignment="Top"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
