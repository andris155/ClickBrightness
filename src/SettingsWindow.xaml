<Window
    x:Class="BrightnessApp.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BrightnessApp"
    Title="ClickBrightness settings">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="28"/>
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="144"/>
            </Grid.ColumnDefinitions>

            <!-- Left App Title & Icon -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10" Padding="16,0,16,0" IsHitTestVisible="False">
                <Image x:Name="AppTitleBarIcon" Width="16" Height="16" VerticalAlignment="Center"/>
                <TextBlock x:Name="AppTitleBarText" Text="ClickBrightness settings" FontSize="13" FontWeight="Normal" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Centered Search Box -->
            <AutoSuggestBox x:Name="SettingsSearchBox"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Width="320"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            PlaceholderText="Search settings"
                            QueryIcon="Find"/>
        </Grid>

        <!-- Modern Fluent Navigation with Submenus -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="210"
                        CompactPaneLength="48"
                        Background="Transparent">
            <NavigationView.Resources>
                <!-- Remove secondary content background layer, margins and borders for seamless Mica backdrop -->
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
                <Thickness x:Key="NavigationViewPageContentMargin">0</Thickness>
                <Thickness x:Key="NavigationViewContentGridMargin">0</Thickness>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavItemGeneral" Content="General" Tag="General" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemShortcuts" Content="Shortcuts" Tag="Shortcuts">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE765;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemOSD" Content="On-Screen Display" Tag="OSD">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7F4;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemTray" Content="System Tray" Tag="Tray">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE718;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemFlyoutSlider" Content="Flyout Slider" Tag="FlyoutSlider">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE9E9;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavItemAbout" Content="About" Tag="About">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE946;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <ScrollViewer Padding="24,4,24,16" VerticalScrollBarVisibility="Visible">
                    <Grid x:Name="SubmenuContainer" MaxWidth="680" HorizontalAlignment="Stretch">
                        <Grid.ChildrenTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="28"/>
                            </TransitionCollection>
                        </Grid.ChildrenTransitions>

                        <!-- ========================================== -->
                        <!-- SUBMENU 1: GENERAL                         -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="GeneralPanel" Visibility="Visible" Spacing="0">
                            <StackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="20"/>
                                </TransitionCollection>
                            </StackPanel.ChildrenTransitions>
                            <!-- Page Title & Header Banner -->
                            <Grid Padding="4,4,4,12" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE706;" FontSize="32" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="GeneralHeaderTitle" Text="General Settings" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="GeneralHeaderSubtitle" Text="Windows 11 DDC/CI Hardware Monitor Brightness Control" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <InfoBar x:Name="HardwareStatusInfoBar" IsOpen="False" IsClosable="False" Severity="Warning" Margin="0,0,0,12"/>

                            <!-- App Theme & Language -->
                            <TextBlock x:Name="AppearanceSectionTitle" Text="Appearance" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,6"/>

                            <!-- Language Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE774;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="LanguageTitleText" Text="Language" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="LanguageDescText" Text="Select application display language. If the Windows language is unsupported, English (United States) is used." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox x:Name="LanguageComboBox" Grid.Column="2" Width="210" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- App Theme Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE790;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="AppThemeTitleText" Text="App Theme" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="AppThemeDescText" Text="Visual appearance of the settings window" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox x:Name="AppThemeComboBox" Grid.Column="2" Width="210" VerticalAlignment="Center">
                                        <ComboBoxItem x:Name="AppThemeItemFollowWindows" Content="Follow Windows (app)"/>
                                        <ComboBoxItem x:Name="AppThemeItemDark" Content="Dark"/>
                                        <ComboBoxItem x:Name="AppThemeItemLight" Content="Light"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Transparency Effects Toggle -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE81E;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="TransparencyEffectsTitleText" Text="Transparency Effects" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="TransparencyEffectsDescText" Text="Enable Mica and Acrylic backdrop transparency across all app windows" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="TransparencyEffectsStatusText" Text="On" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="TransparencyEffectsToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- System & Hardware -->
                            <TextBlock x:Name="StartupDisplaysSectionTitle" Text="Startup &amp; Displays" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,6"/>

                            <!-- Start with Windows -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7E8;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="StartWithWindowsTitleText" Text="Start with Windows" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="StartWithWindowsDescText" Text="Launch ClickBrightness automatically on system logon" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="StartWithWindowsStatusText" Text="Off" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="StartWithWindowsToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Target Monitors Selection Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE7F4;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock x:Name="MonitorsToControlTitleText" Text="Monitors to Control" FontSize="14" FontWeight="Normal"/>
                                            <TextBlock x:Name="MonitorsToControlDescText" Text="Select which monitors have their brightness adjusted" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="AllMonitorsCheckBox" Grid.Column="2" Content="All Monitors" IsChecked="True" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel x:Name="MonitorsListStackPanel" Margin="36,0,0,0" Spacing="6"/>
                                </StackPanel>
                            </Border>

                            <!-- Physical Monitors status & redetect -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7F4;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="PhysicalMonitorsTitleText" Text="Physical Monitors" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="MonitorsSummaryText" Text="Detecting..." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="RedetectMonitorsButton" Grid.Column="2" Content="Re-detect" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Reset Defaults -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,12,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE777;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="ResetDefaultsTitleText" Text="Reset Settings" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="ResetDefaultsDescText" Text="Restore all settings to their default values" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="ResetDefaultsButton" Grid.Column="2" VerticalAlignment="Center" ToolTipService.ToolTip="Reset all settings to default values">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE777;" FontSize="14"/>
                                            <TextBlock x:Name="ResetDefaultsButtonText" Text="Reset Defaults"/>
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout x:Name="ResetDefaultsFlyout" Placement="TopEdgeAlignedRight">
                                                <StackPanel Spacing="12" MaxWidth="300">
                                                    <TextBlock x:Name="ResetDefaultsConfirmText" Text="All settings will be reset. Do you want to continue?" Style="{ThemeResource BaseTextBlockStyle}" TextWrapping="Wrap"/>
                                                    <Button x:Name="ConfirmResetDefaultsButton" Content="Yes, reset settings"/>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ========================================== -->
                        <!-- SUBMENU 2: SHORTCUTS                       -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="ShortcutsPanel" Visibility="Collapsed" Spacing="0">
                            <StackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="20"/>
                                </TransitionCollection>
                            </StackPanel.ChildrenTransitions>
                            <!-- Page Title & Header Banner -->
                            <Grid Padding="4,4,4,12" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE765;" FontSize="32" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ShortcutsHeaderTitle" Text="Keyboard Shortcuts" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ShortcutsHeaderSubtitle" Text="Global hotkeys for brightness stepping and preset jumping" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Section: Stepping Shortcuts -->
                            <TextBlock x:Name="ShortcutsAdjustSectionTitle" Text="Brightness Stepping Shortcuts" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <!-- Enable Adjust Shortcuts Toggle -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE765;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="HotkeyAdjustTitleText" Text="Increase &amp; Decrease Shortcuts" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="HotkeyAdjustDescText" Text="Enable global keyboard shortcuts to raise and lower brightness" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="HotkeyAdjustStatusText" Text="On" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="HotkeyAdjustToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Increase Brightness -->
                            <Border x:Name="KeyUpCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE706;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="KeyUpTitleText" Text="Increase Brightness" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="KeyUpDescText" Text="Global shortcut to raise hardware brightness" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="KeyUpButton" Grid.Column="2" Content="F14" MinWidth="140" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Decrease Brightness -->
                            <Border x:Name="KeyDownCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE708;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="KeyDownTitleText" Text="Decrease Brightness" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="KeyDownDescText" Text="Global shortcut to lower hardware brightness" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="KeyDownButton" Grid.Column="2" Content="F13" MinWidth="140" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Brightness Step -->
                            <Border x:Name="StepCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE9D2;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="StepTitleText" Text="Brightness Step" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="StepDescText" Text="Percentage adjustment per hotkey press" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox x:Name="StepComboBox" Grid.Column="2" Width="90" VerticalAlignment="Center">
                                        <ComboBoxItem Content="1%"/>
                                        <ComboBoxItem Content="2%"/>
                                        <ComboBoxItem Content="5%"/>
                                        <ComboBoxItem Content="10%"/>
                                        <ComboBoxItem Content="15%"/>
                                        <ComboBoxItem Content="20%"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Show OSD when Stepping Hotkeys Toggle -->
                            <Border x:Name="HotkeyAdjustShowOsdCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7F4;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="HotkeyAdjustShowOsdTitleText" Text="Show OSD Banner" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="HotkeyAdjustShowOsdDescText" Text="Display the on-screen brightness banner when pressing stepping hotkeys" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock x:Name="HotkeyAdjustShowOsdStatusText" Text="On" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="HotkeyAdjustShowOsdToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Preset Shortcuts Section -->
                            <TextBlock x:Name="ShortcutsPresetsSectionTitle" Text="Preset Shortcuts" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,6"/>

                            <!-- Enable Preset Shortcuts Toggle -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE734;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="HotkeyPresetsTitleText" Text="Preset Shortcuts" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="HotkeyPresetsDescText" Text="Enable global keyboard shortcuts to jump to brightness presets" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="HotkeyPresetsStatusText" Text="On" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="HotkeyPresetsToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Preset 1 Shortcut Key -->
                            <Border x:Name="Preset1KeyCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE734;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="Preset1KeyTitleText" Text="Preset 1 Shortcut" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="Preset1KeyDescText" Text="Global shortcut to set brightness to Preset 1" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="KeyPreset1Button" Grid.Column="2" Content="F15" MinWidth="140" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Preset 1 Brightness Level -->
                            <Border x:Name="Preset1BrightnessCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE706;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="Preset1BrightnessTitleText" Text="Preset 1 Brightness (%)" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="Preset1BrightnessDescText" Text="Target brightness level applied by the Preset 1 shortcut" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Slider x:Name="Preset1BrightnessSlider" Minimum="0" Maximum="100" StepFrequency="1" Width="160" VerticalAlignment="Center"/>
                                        <NumberBox x:Name="Preset1BrightnessNumberBox" Minimum="0" Maximum="100" Width="90" SpinButtonPlacementMode="Hidden" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Preset 2 Shortcut Key -->
                            <Border x:Name="Preset2KeyCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE734;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="Preset2KeyTitleText" Text="Preset 2 Shortcut" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="Preset2KeyDescText" Text="Global shortcut to set brightness to Preset 2" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="KeyPreset2Button" Grid.Column="2" Content="F16" MinWidth="140" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Preset 2 Brightness Level -->
                            <Border x:Name="Preset2BrightnessCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE706;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="Preset2BrightnessTitleText" Text="Preset 2 Brightness (%)" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="Preset2BrightnessDescText" Text="Target brightness level applied by the Preset 2 shortcut" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Slider x:Name="Preset2BrightnessSlider" Minimum="0" Maximum="100" StepFrequency="1" Width="160" VerticalAlignment="Center"/>
                                        <NumberBox x:Name="Preset2BrightnessNumberBox" Minimum="0" Maximum="100" Width="90" SpinButtonPlacementMode="Hidden" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Show OSD for Preset Shortcuts Toggle -->
                            <Border x:Name="HotkeyPresetsShowOsdCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7F4;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="HotkeyPresetsShowOsdTitleText" Text="Show OSD Banner" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="HotkeyPresetsShowOsdDescText" Text="Display the on-screen brightness banner when switching presets" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock x:Name="HotkeyPresetsShowOsdStatusText" Text="On" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="HotkeyPresetsShowOsdToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Reset Hotkeys -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE777;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="ResetShortcutsTitleText" Text="Reset Shortcuts" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="ResetShortcutsDescText" Text="Restore hotkeys to defaults (F14, F13, F15, F16)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="ResetHotkeysButton" Grid.Column="2" Content="Reset Hotkeys" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Timing & Hardware Delay Header -->
                            <TextBlock x:Name="TimingDelaySectionTitle" Text="Timing &amp; Hardware Delay" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,6"/>

                            <!-- Delayed Brightness Change -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE823;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="DelayEnabledTitleText" Text="Delayed Brightness Change" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="DelayEnabledDescText" Text="Debounce rapid key presses before hardware adjustments" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="DelayEnabledStatusText" Text="On" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="DelayEnabledToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Wait Time -->
                            <Border x:Name="DelayWaitTimeCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE916;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="WaitTimeTitleText" Text="Wait Time (ms)" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="WaitTimeDescText" Text="Hardware debounce delay before updating monitor" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Slider x:Name="DelaySlider" Minimum="100" Maximum="3000" StepFrequency="50" Width="160" VerticalAlignment="Center"/>
                                        <NumberBox x:Name="DelayNumberBox" Minimum="100" Maximum="3000" Width="90" SpinButtonPlacementMode="Hidden" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Hold Speed (Repeat Interval) -->
                            <Border x:Name="HoldSpeedCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8EE;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="HoldSpeedTitleText" Text="Hold Speed (ms)" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="HoldSpeedDescText" Text="Key hold interval for smooth stepping (higher = slower)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Slider x:Name="RepeatSlider" Minimum="20" Maximum="500" StepFrequency="10" Width="160" VerticalAlignment="Center"/>
                                        <NumberBox x:Name="RepeatNumberBox" Minimum="20" Maximum="500" Width="90" SpinButtonPlacementMode="Hidden" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ========================================== -->
                        <!-- SUBMENU 3: ON-SCREEN DISPLAY (OSD)         -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="OsdPanel" Visibility="Collapsed" Spacing="0">
                            <StackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="20"/>
                                </TransitionCollection>
                            </StackPanel.ChildrenTransitions>
                            <!-- Page Title & Header Banner -->
                            <Grid Padding="4,4,4,12" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7F4;" FontSize="32" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="OsdHeaderTitle" Text="On-Screen Display (OSD)" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="OsdHeaderSubtitle" Text="Visual overlay popup for real-time brightness adjustments" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- OSD Theme -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE771;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="OverlayThemeTitleText" Text="OSD Banner Theme" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="OverlayThemeDescText" Text="Visual appearance and color theme of the brightness overlay banner" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox x:Name="OverlayThemeComboBox" Grid.Column="2" Width="210" VerticalAlignment="Center">
                                        <ComboBoxItem x:Name="OverlayThemeItemFollowWindows" Content="Follow Windows (system)"/>
                                        <ComboBoxItem x:Name="OverlayThemeItemDark" Content="Dark"/>
                                        <ComboBoxItem x:Name="OverlayThemeItemLight" Content="Light"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- SECTION: ACCENT COLOR -->
                            <TextBlock x:Name="OsdAccentSectionTitle" Text="Accent Color" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,6"/>

                            <!-- Use Windows Accent Color (Overlay) -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE790;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="OverlayUseWindowsAccentTitleText" Text="Use Windows Accent Color" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="OverlayUseWindowsAccentDescText" Text="Apply system accent color to the overlay brightness bar" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="OverlayUseWindowsAccentStatusText" Text="On" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="OverlayUseWindowsAccentToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Custom Accent Color (Overlay) -->
                            <Border x:Name="OverlayAccentColorCard" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE790;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="OverlayCustomAccentTitleText" Text="Custom Accent Color" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="OverlayCustomAccentDescText" Text="Fill color for overlay brightness bar (configured when Windows accent is off)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button x:Name="OverlayAccentColorPickerButton" Padding="0" Width="32" Height="32" CornerRadius="4" ToolTipService.ToolTip="Choose color">
                                            <Border x:Name="OverlayAccentColorPreview" Width="24" Height="24" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                            <Button.Flyout>
                                                <Flyout Placement="Bottom">
                                                    <ColorPicker x:Name="OverlayAccentColorPicker" IsAlphaEnabled="False" IsColorSpectrumVisible="True" IsColorChannelTextInputVisible="False"/>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <TextBox x:Name="OverlayAccentColorTextBox" Width="95" VerticalAlignment="Center" MaxLength="9"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- SECTION: TIMING -->
                            <TextBlock x:Name="OsdTimingSectionTitle" Text="Timing" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,6"/>

                            <!-- Hide Time -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE890;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="OverlayTimeoutTitleText" Text="Hide Time (ms)" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="OverlayTimeoutDescText" Text="Auto-hide timeout for banner overlay" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Slider x:Name="OverlayTimeoutSlider" Minimum="500" Maximum="10000" StepFrequency="250" Width="160" VerticalAlignment="Center"/>
                                        <NumberBox x:Name="OverlayTimeoutNumberBox" Minimum="500" Maximum="10000" Width="90" SpinButtonPlacementMode="Hidden" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ========================================== -->
                        <!-- SUBMENU 4: SYSTEM TRAY                     -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="TrayPanel" Visibility="Collapsed" Spacing="0">
                            <StackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="20"/>
                                </TransitionCollection>
                            </StackPanel.ChildrenTransitions>
                            <!-- Page Title & Header Banner -->
                            <Grid Padding="4,4,4,12" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE718;" FontSize="32" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TrayHeaderTitle" Text="System Tray Icon" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TrayHeaderSubtitle" Text="Taskbar indicator, live percentage typography, and mouse actions" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Appearance Section -->
                            <TextBlock x:Name="TrayAppearanceSectionTitle" Text="System Tray Icon" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <!-- Show Percentage Icon Toggle -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE9D2;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="TrayShowPercentageTitleText" Text="Show Percentage Icon" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="TrayShowPercentageDescText" Text="Display current brightness percentage on the system tray icon" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="TrayShowPercentageStatusText" Text="On" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="TrayShowPercentageToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Typography Section (Hidden when percentage icon is disabled) -->
                            <StackPanel x:Name="TrayTypographyPanel" Spacing="0">
                                <TextBlock x:Name="TrayTypographySectionTitle" Text="System Tray Icon Typography" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,6"/>

                                <!-- Number Font -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8D2;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock x:Name="TrayFontTitleText" Text="Number Font" FontSize="14" FontWeight="Normal"/>
                                            <TextBlock x:Name="TrayFontDescText" Text="DirectWrite rendered font for tray icon" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox x:Name="TrayFontComboBox" Grid.Column="2" Width="200" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Font Size -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8E9;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock x:Name="TrayFontSizeTitleText" Text="Font Size (%)" FontSize="14" FontWeight="Normal"/>
                                            <TextBlock x:Name="TrayFontSizeDescText" Text="Scale for 1-2 digits (0-99%)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
