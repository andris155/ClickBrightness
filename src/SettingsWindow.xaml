<Window
    x:Class="BrightnessApp.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BrightnessApp"
    Title="ClickBrightness settings">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="28"/>
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="144"/>
            </Grid.ColumnDefinitions>

            <!-- Left Back Button + App Title & Icon -->
            <StackPanel x:Name="TitleBarLeftPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6" Padding="16,0,16,0">
                <Button x:Name="TitleBarBackButton"
                        Width="36" Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        IsEnabled="False"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="12"/>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10" IsHitTestVisible="False">
                    <Image x:Name="AppTitleBarIcon" Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AppTitleBarText" Text="ClickBrightness settings" FontSize="13" FontWeight="Normal" VerticalAlignment="Center" Margin="0,-1.5,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Centered Search Box -->
            <AutoSuggestBox x:Name="SettingsSearchBox"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Width="320"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            PlaceholderText="Search settings"
                            QueryIcon="Find"/>
        </Grid>

        <!-- Modern Fluent Navigation with Submenus -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="210"
                        CompactPaneLength="48"
                        Background="Transparent">
            <NavigationView.Resources>
                <!-- Remove secondary content background layer, margins and borders for seamless Mica backdrop -->
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
                <Thickness x:Key="NavigationViewPageContentMargin">0</Thickness>
                <Thickness x:Key="NavigationViewContentGridMargin">0</Thickness>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavItemGeneral" Content="General" Tag="General" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemMonitors" Content="Monitors" Tag="Monitors">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7F4;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemTimings" Content="Timings &amp; Global" Tag="Timings">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE916;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavItemAbout" Content="About" Tag="About">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE946;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <ScrollViewer x:Name="SettingsScrollViewer" Padding="24,4,24,16" VerticalScrollBarVisibility="Visible">
                    <Grid x:Name="SubmenuContainer" MaxWidth="680" HorizontalAlignment="Stretch">
                        <Grid.ChildrenTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="28"/>
                            </TransitionCollection>
                        </Grid.ChildrenTransitions>

                        <!-- ========================================== -->
                        <!-- SUBMENU 1: GENERAL                         -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="GeneralPanel" Visibility="Visible" Spacing="0">
                            <StackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="20"/>
                                </TransitionCollection>
                            </StackPanel.ChildrenTransitions>
                            <!-- Page Title & Header Banner -->
                            <Grid Padding="4,4,4,12" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE706;" FontSize="32" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="GeneralHeaderTitle" Text="General Settings" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="GeneralHeaderSubtitle" Text="Windows 11 DDC/CI Hardware Monitor Brightness Control" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <InfoBar x:Name="HardwareStatusInfoBar" IsOpen="False" IsClosable="False" Severity="Warning" Margin="0,0,0,12"/>

                            <!-- App Theme & Language -->
                            <TextBlock x:Name="AppearanceSectionTitle" Text="Appearance" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,6"/>

                            <!-- Language Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE774;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="LanguageTitleText" Text="Language" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="LanguageDescText" Text="Select application display language. If the Windows language is unsupported, English (United States) is used." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox x:Name="LanguageComboBox" Grid.Column="2" Width="210" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- App Theme Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE790;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="AppThemeTitleText" Text="App Theme" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="AppThemeDescText" Text="Visual appearance of the settings window" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox x:Name="AppThemeComboBox" Grid.Column="2" Width="210" VerticalAlignment="Center">
                                        <ComboBoxItem x:Name="AppThemeItemFollowWindows" Content="Follow Windows (app)"/>
                                        <ComboBoxItem x:Name="AppThemeItemDark" Content="Dark"/>
                                        <ComboBoxItem x:Name="AppThemeItemLight" Content="Light"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Transparency Effects Toggle -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE81E;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="TransparencyEffectsTitleText" Text="Transparency Effects" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="TransparencyEffectsDescText" Text="Enable Mica and Acrylic backdrop transparency across all app windows" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="TransparencyEffectsStatusText" Text="On" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="TransparencyEffectsToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- System & Hardware -->
                            <TextBlock x:Name="StartupDisplaysSectionTitle" Text="Startup &amp; Displays" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,6"/>

                            <!-- Start with Windows -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7E8;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="StartWithWindowsTitleText" Text="Start with Windows" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="StartWithWindowsDescText" Text="Launch ClickBrightness automatically on system logon" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="StartWithWindowsStatusText" Text="Off" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="StartWithWindowsToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Physical Monitors status & redetect -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7F4;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="PhysicalMonitorsTitleText" Text="Physical Monitors" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="MonitorsSummaryText" Text="Detecting..." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="RedetectMonitorsButton" Grid.Column="2" Content="Re-detect" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Reset Defaults -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,12,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE777;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="ResetDefaultsTitleText" Text="Reset Settings" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="ResetDefaultsDescText" Text="Restore all settings to their default values" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="ResetDefaultsButton" Grid.Column="2" VerticalAlignment="Center" ToolTipService.ToolTip="Reset all settings to default values">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE777;" FontSize="14"/>
                                            <TextBlock x:Name="ResetDefaultsButtonText" Text="Reset Defaults"/>
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout x:Name="ResetDefaultsFlyout" Placement="TopEdgeAlignedRight">
                                                <StackPanel Spacing="12" MaxWidth="300">
                                                    <TextBlock x:Name="ResetDefaultsConfirmText" Text="All settings will be reset. Do you want to continue?" Style="{ThemeResource BaseTextBlockStyle}" TextWrapping="Wrap"/>
                                                    <Button x:Name="ConfirmResetDefaultsButton" Content="Yes, reset settings"/>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ========================================== -->
                        <!-- SUBMENU 2: MONITORS                        -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="MonitorsPanel" Visibility="Collapsed" Spacing="0">
                            <Grid x:Name="MonitorsViewHost">
                                <Grid.ChildrenTransitions>
                                    <TransitionCollection>
                                        <EntranceThemeTransition x:Name="MonitorsViewTransition" FromHorizontalOffset="0" FromVerticalOffset="20"/>
                                    </TransitionCollection>
                                </Grid.ChildrenTransitions>

                            <!-- Main Monitors View -->
                            <StackPanel x:Name="MonitorsMainView" Spacing="0">
                            <!-- Page Title & Header Banner -->
                            <Grid Padding="4,4,4,12" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7F4;" FontSize="32" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="MonitorsHeaderTitle" Text="Monitors &amp; Displays" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="MonitorsHeaderSubtitle" Text="Configure main display, sync/separate modes, offsets, and per-monitor controls" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Main Display Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7F4;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="MainMonitorTitleText" Text="Main Display" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="MainMonitorDescText" Text="Primary reference display used for brightness offsets and Sync mode" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox x:Name="MainMonitorComboBox" Grid.Column="2" Width="220" VerticalAlignment="Center">
                                        <FlyoutBase.AttachedFlyout>
                                            <Flyout x:Name="MainMonitorConfirmFlyout" Placement="BottomEdgeAlignedRight">
                                                <StackPanel Spacing="12" MaxWidth="300">
                                                    <TextBlock x:Name="MainMonitorConfirmText" Text="Changing the main display will update Sync mode and tray icons. Do you want to continue?" Style="{ThemeResource BaseTextBlockStyle}" TextWrapping="Wrap"/>
                                                    <Button x:Name="ConfirmMainMonitorButton" Content="Yes, change main display"/>
                                                </StackPanel>
                                            </Flyout>
                                        </FlyoutBase.AttachedFlyout>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Sync External Monitors with Laptop Fn Keys (Conditional: only when Main Display is internal) -->
                            <Border x:Name="SyncLaptopFnKeysCard" Visibility="Collapsed"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE706;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="SyncLaptopFnKeysTitleText" Text="Sync External Monitors with Laptop Fn Keys" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="SyncLaptopFnKeysDescText" Text="Automatically sync external Sync-mode monitors when adjusting internal display brightness via laptop Fn keys" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="SyncLaptopFnKeysStatusText" Text="Off" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="SyncLaptopFnKeysToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Show Separate Monitors in Multi-Monitor Flyout -->
                            <Border x:Name="ShowSeparateInMultiFlyoutCard"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7F4;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="ShowSeparateInMultiFlyoutTitleText" Text="Show Separate Monitors in Multi-Monitor Flyout" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="ShowSeparateInMultiFlyoutDescText" Text="Include Separate-mode displays with their individual preset buttons in the main multi-monitor flyout" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="ShowSeparateInMultiFlyoutStatusText" Text="On" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="ShowSeparateInMultiFlyoutToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Disable Brightness Control for Turned-Off Monitors -->
                            <Border x:Name="DisableTurnedOffControlCard"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7E8;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="DisableTurnedOffControlTitleText" Text="Disable Control for Turned-Off Monitors" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="DisableTurnedOffControlDescText" Text="Prevent brightness changes and OSD popups for displays detected as switched off" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="DisableTurnedOffControlStatusText" Text="Off" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="DisableTurnedOffControlToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Section: Per-Monitor Configuration -->
                            <TextBlock x:Name="MonitorConfigSectionTitle" Text="Display Configuration" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,6"/>

                            <!-- Monitor Selector ComboBox -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE9D2;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="ConfigMonitorSelectTitleText" Text="Selected Display" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="ConfigMonitorSelectDescText" Text="Choose a detected display to configure its mode, name, and controls" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ConfigMonitorComboBox" Grid.Column="2" Width="220" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Brightness Control Enable/Disable -->
                            <Border x:Name="MonitorEnabledCard"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7E8;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="MonitorEnabledTitleText" Text="Brightness Control" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="MonitorEnabledDescText" Text="Enable or disable brightness adjustments for this display" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="MonitorEnabledStatusText" Text="On" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="MonitorEnabledToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Monitor Custom Name -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8AC;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="MonitorCustomNameTitleText" Text="Monitor Name" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="MonitorCustomNameDescText" Text="Display label shown in the OSD banner and flyout slider (max 20 characters)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBox x:Name="MonitorCustomNameTextBox" Grid.Column="2" Width="220" MaxLength="20" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Control Mode (Sync / Separate) -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE895;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="MonitorControlModeTitleText" Text="Control Mode" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="MonitorControlModeDescText" Text="Sync follows the Main Display with an offset; Separate uses independent controls" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox x:Name="MonitorControlModeComboBox" Grid.Column="2" Width="160" VerticalAlignment="Center">
                                        <ComboBoxItem x:Name="MonitorModeItemSync" Content="Sync"/>
                                        <ComboBoxItem x:Name="MonitorModeItemSeparate" Content="Separate"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Brightness Offset (Sync mode, non-Main) -->
                            <Border x:Name="MonitorOffsetCard" Visibility="Collapsed"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE948;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="MonitorOffsetTitleText" Text="Brightness Offset (%)" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="MonitorOffsetDescText" Text="Relative brightness offset applied compared to the Main Display" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Slider x:Name="MonitorOffsetSlider" Minimum="-100" Maximum="100" StepFrequency="1" Width="160" VerticalAlignment="Center"/>
                                        <NumberBox x:Name="MonitorOffsetNumberBox" Minimum="-100" Maximum="100" Width="90" SpinButtonPlacementMode="Hidden" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Sync Overscroll Max (100%) (Sync mode, non-Main) -->
                            <Border x:Name="SyncOverscrollMaxCard" Visibility="Collapsed"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE74A;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="SyncOverscrollMaxTitleText" Text="Overscroll when a display is at 100%" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="SyncOverscrollMaxDescText" Text="Continue increasing other synced displays even when at least one synced display is already at 100%" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="SyncOverscrollMaxStatusText" Text="On" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="SyncOverscrollMaxToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Sync Overscroll Min (0%) (Sync mode, non-Main) -->
                            <Border x:Name="SyncOverscrollMinCard" Visibility="Collapsed"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE74B;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="SyncOverscrollMinTitleText" Text="Overscroll when a display is at 0%" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="SyncOverscrollMinDescText" Text="Continue decreasing other synced displays even when at least one synced display is already at 0%" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="SyncOverscrollMinStatusText" Text="On" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="SyncOverscrollMinToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Sync Mode Notice Banner (non-Main Sync displays) -->
                            <Border x:Name="MonitorSyncNoticeBanner" Visibility="Collapsed"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,6,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE946;" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                    <TextBlock x:Name="MonitorSyncNoticeText" Grid.Column="1" Text="This display is in Sync mode and uses the Main Display's shortcuts and wheel controls. You can customize its OSD color, Flyout color, and optional tray icon below." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Windows Settings-style Submenu Navigation Cards -->
                            <TextBlock x:Name="MonitorSubmenusSectionTitle" Text="Customization &amp; Controls" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,6"/>

                            <Button x:Name="MonitorsShortcutsCard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE765;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="SubmenuShortcutsTitleText" Text="Keyboard Shortcuts" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="SubmenuShortcutsDescText" Text="Global hotkeys for brightness stepping and preset jumping" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Button>

                            <Button x:Name="MonitorsOsdCard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7F4;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="SubmenuOsdTitleText" Text="On-Screen Display (OSD)" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="SubmenuOsdDescText" Text="Overlay accent color for this display" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Button>

                            <Button x:Name="MonitorsTrayCard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE718;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="SubmenuTrayTitleText" Text="System Tray Icon" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="SubmenuTrayDescText" Text="Taskbar tray icon, typography, and mouse actions" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Button>

                            <Button x:Name="MonitorsFlyoutCard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE9E9;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="SubmenuFlyoutTitleText" Text="Flyout Slider" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="SubmenuFlyoutDescText" Text="Flyout scrolling and slider accent color" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Button>

                            <Button x:Name="MonitorsScheduleCard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE823;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="SubmenuScheduleTitleText" Text="Schedule" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="SubmenuScheduleDescText" Text="Automatic day and night brightness schedule" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Button>
                            </StackPanel>

                            <!-- Subpage View (Breadcrumb + Customizations) -->
                            <StackPanel x:Name="MonitorsSubpageView" Visibility="Collapsed" Spacing="0">

                                <!-- Subpage Breadcrumb Header -->
                                <StackPanel x:Name="MonitorsBreadcrumbHeader" Spacing="2" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button x:Name="MonitorsBreadcrumbRootButton" Background="Transparent" BorderThickness="0" Padding="4,2" CornerRadius="4" VerticalAlignment="Center">
                                            <TextBlock x:Name="MonitorsBreadcrumbRootText" Text="Monitors" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Button>
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="MonitorsBreadcrumbCurrentText" Text="Shortcuts" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="MonitorsBreadcrumbTargetText" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,0,0,0"/>
                                </StackPanel>

                            <!-- Per-Monitor Customizations (Subpage Container) -->
                            <StackPanel x:Name="MonitorCustomizationsPanel" Spacing="0">
                            <StackPanel x:Name="ShortcutsCustomSection" Spacing="0">
                            <!-- Section: Stepping Shortcuts -->
                            <TextBlock x:Name="ShortcutsAdjustSectionTitle" Text="Brightness Stepping Shortcuts" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <!-- Enable Adjust Shortcuts Toggle -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE765;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="HotkeyAdjustTitleText" Text="Increase &amp; Decrease Shortcuts" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="HotkeyAdjustDescText" Text="Enable global keyboard shortcuts to raise and lower brightness" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="HotkeyAdjustStatusText" Text="On" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="HotkeyAdjustToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Increase Brightness -->
                            <Border x:Name="KeyUpCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE706;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="KeyUpTitleText" Text="Increase Brightness" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="KeyUpDescText" Text="Global shortcut to raise hardware brightness" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="KeyUpButton" Grid.Column="2" Content="F14" MinWidth="140" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Decrease Brightness -->
                            <Border x:Name="KeyDownCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE708;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="KeyDownTitleText" Text="Decrease Brightness" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="KeyDownDescText" Text="Global shortcut to lower hardware brightness" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="KeyDownButton" Grid.Column="2" Content="F13" MinWidth="140" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Brightness Step -->
                            <Border x:Name="StepCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE9D2;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="StepTitleText" Text="Brightness Step" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="StepDescText" Text="Percentage adjustment per hotkey press" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox x:Name="StepComboBox" Grid.Column="2" Width="90" VerticalAlignment="Center">
                                        <ComboBoxItem Content="1%"/>
                                        <ComboBoxItem Content="2%"/>
                                        <ComboBoxItem Content="5%"/>
                                        <ComboBoxItem Content="10%"/>
                                        <ComboBoxItem Content="15%"/>
                                        <ComboBoxItem Content="20%"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Show OSD when Stepping Hotkeys Toggle -->
                            <Border x:Name="HotkeyAdjustShowOsdCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7F4;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="HotkeyAdjustShowOsdTitleText" Text="Show OSD Banner" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="HotkeyAdjustShowOsdDescText" Text="Display the on-screen brightness banner when pressing stepping hotkeys" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock x:Name="HotkeyAdjustShowOsdStatusText" Text="On" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="HotkeyAdjustShowOsdToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Preset Shortcuts Section -->
                            <TextBlock x:Name="ShortcutsPresetsSectionTitle" Text="Preset Shortcuts" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,6"/>

                            <!-- Enable Preset Shortcuts Toggle -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE734;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="HotkeyPresetsTitleText" Text="Preset Shortcuts" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="HotkeyPresetsDescText" Text="Enable global keyboard shortcuts to jump to brightness presets" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="HotkeyPresetsStatusText" Text="On" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="HotkeyPresetsToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Preset 1 Shortcut Key -->
                            <Border x:Name="Preset1KeyCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE734;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="Preset1KeyTitleText" Text="Preset 1 Shortcut" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="Preset1KeyDescText" Text="Global shortcut to set brightness to Preset 1" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="KeyPreset1Button" Grid.Column="2" Content="F15" MinWidth="140" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Preset 1 Brightness Level -->
