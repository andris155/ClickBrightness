                                    <FontIcon Glyph="&#xE962;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="FlyoutScrollEnabledTitleText" Text="Slider Scrolling" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="FlyoutScrollEnabledDescText" Text="Adjust brightness by scrolling the mouse wheel over the flyout slider" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="FlyoutScrollEnabledStatusText" Text="On" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="FlyoutScrollEnabledToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Flyout Slider Scrolling Brightness Step -->
                            <Border x:Name="FlyoutScrollStepCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE9D2;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="FlyoutScrollStepTitleText" Text="Scrolling Brightness Step" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="FlyoutScrollStepDescText" Text="Percentage adjustment per mouse wheel notch on the flyout slider" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox x:Name="FlyoutScrollStepComboBox" Grid.Column="2" Width="90" VerticalAlignment="Center">
                                        <ComboBoxItem Content="1%"/>
                                        <ComboBoxItem Content="2%"/>
                                        <ComboBoxItem Content="5%"/>
                                        <ComboBoxItem Content="10%"/>
                                        <ComboBoxItem Content="15%"/>
                                        <ComboBoxItem Content="20%"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            </StackPanel>
                            <StackPanel x:Name="FlyoutAccentCustomSection" Spacing="0">
                            <!-- SECTION: ACCENT COLOR -->
                            <TextBlock x:Name="FlyoutAccentSectionTitle" Text="Flyout Accent Color" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,6"/>

                            <!-- Use Windows Accent Color (Flyout) -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE790;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="FlyoutUseWindowsAccentTitleText" Text="Use Windows Accent Color" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="FlyoutUseWindowsAccentDescText" Text="Apply system accent color to the flyout slider filled track" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="FlyoutUseWindowsAccentStatusText" Text="On" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="FlyoutUseWindowsAccentToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Custom Accent Color (Flyout) -->
                            <Border x:Name="FlyoutAccentColorCard" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE790;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="FlyoutCustomAccentTitleText" Text="Custom Accent Color" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="FlyoutCustomAccentDescText" Text="Fill color for flyout slider track (configured when Windows accent is off)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button x:Name="FlyoutAccentColorPickerButton" Padding="0" Width="32" Height="32" CornerRadius="4" ToolTipService.ToolTip="Choose color">
                                            <Border x:Name="FlyoutAccentColorPreview" Width="24" Height="24" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                            <Button.Flyout>
                                                <Flyout Placement="Bottom">
                                                    <ColorPicker x:Name="FlyoutAccentColorPicker" IsAlphaEnabled="False" IsColorSpectrumVisible="True" IsColorChannelTextInputVisible="False"/>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <TextBox x:Name="FlyoutAccentColorTextBox" Width="95" VerticalAlignment="Center" MaxLength="9"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Separate Dark & Light Colors Toggle (Flyout) -->
                            <Border x:Name="FlyoutDualColorCard" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE708;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="FlyoutDualColorTitleText" Text="Separate Dark &amp; Light Colors" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="FlyoutDualColorDescText" Text="Use a different flyout accent color when the flyout is in dark mode" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="FlyoutDualColorStatusText" Text="Off" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="FlyoutDualColorToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Custom Dark Mode Accent Color (Flyout) -->
                            <Border x:Name="FlyoutDarkColorCard" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE790;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="FlyoutDarkColorTitleText" Text="Dark Mode Color" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="FlyoutDarkColorDescText" Text="Custom accent color for the flyout slider track in dark mode" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button x:Name="FlyoutDarkColorPickerButton" Padding="0" Width="32" Height="32" CornerRadius="4" ToolTipService.ToolTip="Choose color">
                                            <Border x:Name="FlyoutDarkColorPreview" Width="24" Height="24" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                            <Button.Flyout>
                                                <Flyout Placement="Bottom">
                                                    <ColorPicker x:Name="FlyoutDarkColorPicker" IsAlphaEnabled="False" IsColorSpectrumVisible="True" IsColorChannelTextInputVisible="False"/>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <TextBox x:Name="FlyoutDarkColorTextBox" Width="95" VerticalAlignment="Center" MaxLength="9"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            </StackPanel>

                            <!-- Schedule Subpage Section (Hidden for non-main Sync monitors) -->
                            <StackPanel x:Name="ScheduleCustomSection" Visibility="Collapsed" Spacing="0">
                                <TextBlock x:Name="ScheduleModeSectionTitle" Text="Schedule Mode" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,6"/>

                                <!-- Schedule Mode -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE823;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock x:Name="ScheduleModeTitleText" Text="Automatic Schedule" FontSize="14" FontWeight="Normal"/>
                                            <TextBlock x:Name="ScheduleModeDescText" Text="Automatically switch between daytime and nighttime brightness levels" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ScheduleModeComboBox" Grid.Column="2" Width="220" VerticalAlignment="Center">
                                            <ComboBoxItem x:Name="ScheduleModeDisabledItem" Content="Disabled (Manual only)"/>
                                            <ComboBoxItem x:Name="ScheduleModeCustomItem" Content="Custom Time Schedule"/>
                                            <ComboBoxItem x:Name="ScheduleModeSunItem" Content="Sunrise / Sunset Sync"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Show OSD On Scheduled Switch -->
                                <Border x:Name="ScheduleShowOsdCard" Visibility="Collapsed"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE7F4;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock x:Name="ScheduleShowOsdTitleText" Text="Show OSD On Scheduled Switch" FontSize="14" FontWeight="Normal"/>
                                            <TextBlock x:Name="ScheduleShowOsdDescText" Text="Display the on-screen brightness banner when an automatic transition occurs" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="ScheduleShowOsdStatusText" Text="On" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <ToggleSwitch x:Name="ScheduleShowOsdToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Only Show OSD When Brightness Changed -->
                                <Border x:Name="ScheduleOsdOnlyOnChangeCard" Visibility="Collapsed"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE7F4;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock x:Name="ScheduleOsdOnlyOnChangeTitleText" Text="Only Show OSD When Brightness Changed" FontSize="14" FontWeight="Normal"/>
                                            <TextBlock x:Name="ScheduleOsdOnlyOnChangeDescText" Text="Skip the OSD banner if the monitor is already at the scheduled brightness" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="ScheduleOsdOnlyOnChangeStatusText" Text="On" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <ToggleSwitch x:Name="ScheduleOsdOnlyOnChangeToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Brightness Levels -->
                                <StackPanel x:Name="ScheduleBrightnessSection" Visibility="Collapsed" Spacing="0">
                                    <Grid Margin="0,14,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ScheduleBrightnessSectionTitle" Text="Brightness Levels" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button x:Name="ApplyScheduleBrightnessButton" Grid.Column="1" Content="Apply" Style="{ThemeResource AccentButtonStyle}" IsEnabled="False" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Daytime Brightness -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE706;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock x:Name="ScheduleDayBrightnessTitleText" Text="Daytime Brightness (%)" FontSize="14" FontWeight="Normal"/>
                                                <TextBlock x:Name="ScheduleDayBrightnessDescText" Text="Target brightness during daytime or after sunrise" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <Slider x:Name="ScheduleDayBrightnessSlider" Width="120" Minimum="0" Maximum="100" StepFrequency="1" VerticalAlignment="Center"/>
                                                <NumberBox x:Name="ScheduleDayBrightnessNumberBox" Width="90" Minimum="0" Maximum="100" SpinButtonPlacementMode="Hidden" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Nighttime Brightness -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE708;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock x:Name="ScheduleNightBrightnessTitleText" Text="Nighttime Brightness (%)" FontSize="14" FontWeight="Normal"/>
                                                <TextBlock x:Name="ScheduleNightBrightnessDescText" Text="Target brightness during nighttime or after sunset" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <Slider x:Name="ScheduleNightBrightnessSlider" Width="120" Minimum="0" Maximum="100" StepFrequency="1" VerticalAlignment="Center"/>
                                                <NumberBox x:Name="ScheduleNightBrightnessNumberBox" Width="90" Minimum="0" Maximum="100" SpinButtonPlacementMode="Hidden" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Custom Time Schedule -->
                                <StackPanel x:Name="CustomScheduleSection" Visibility="Collapsed" Spacing="0">
                                    <TextBlock x:Name="CustomScheduleSectionTitle" Text="Custom Time Schedule" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,6"/>

                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE706;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock x:Name="ScheduleDayStartTitleText" Text="Daytime Start Time" FontSize="14" FontWeight="Normal"/>
                                                <TextBlock x:Name="ScheduleDayStartDescText" Text="Time of day when Daytime Brightness is applied" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TimePicker x:Name="ScheduleDayTimePicker" Grid.Column="2" ClockIdentifier="24HourClock" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE708;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock x:Name="ScheduleNightStartTitleText" Text="Nighttime Start Time" FontSize="14" FontWeight="Normal"/>
                                                <TextBlock x:Name="ScheduleNightStartDescText" Text="Time of day when Nighttime Brightness is applied" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TimePicker x:Name="ScheduleNightTimePicker" Grid.Column="2" ClockIdentifier="24HourClock" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Sunrise / Sunset Sync -->
                                <StackPanel x:Name="SunScheduleSection" Visibility="Collapsed" Spacing="0">
                                    <TextBlock x:Name="SunScheduleSectionTitle" Text="Sunrise / Sunset Sync" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,6"/>

                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE706;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock x:Name="ScheduleSunTimesTitleText" Text="Today's Solar Times" FontSize="14" FontWeight="Normal"/>
                                                <TextBlock x:Name="ScheduleSunTimesText" Text="Sunrise: 07:00  |  Sunset: 20:00" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button x:Name="ScheduleRefreshSunButton" Grid.Column="2" Content="Refresh" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE707;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock x:Name="ScheduleSunSourceTitleText" Text="Location Source" FontSize="14" FontWeight="Normal"/>
                                                <TextBlock x:Name="ScheduleSunSourceDescText" Text="Choose how geographic location is obtained for solar calculations" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox x:Name="ScheduleSunSourceComboBox" Grid.Column="2" Width="220" VerticalAlignment="Center">
                                                <ComboBoxItem x:Name="ScheduleSunLocItem" Content="Windows Location Service"/>
                                                <ComboBoxItem x:Name="ScheduleSunCoordsItem" Content="Geographic Coordinates"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="ScheduleLocationStatusCard"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE81D;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock x:Name="ScheduleLocationTitleText" Text="Detected Location" FontSize="14" FontWeight="Normal"/>
                                                <TextBlock x:Name="ScheduleLocationText" Text="47.4979, 19.0402" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button x:Name="ScheduleDetectLocationButton" Grid.Column="2" Content="Detect Location" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="ScheduleLatCard" Visibility="Collapsed"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE709;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock x:Name="ScheduleLatTitleText" Text="Latitude" FontSize="14" FontWeight="Normal"/>
                                                <TextBlock x:Name="ScheduleLatDescText" Text="Geographic coordinate north or south of the equator (-90.0° to 90.0°)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <NumberBox x:Name="ScheduleLatNumberBox" Grid.Column="2" Width="120" Minimum="-90" Maximum="90" SpinButtonPlacementMode="Hidden" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

