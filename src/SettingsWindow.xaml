                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="FlyoutButtonWaitTimeTitleText" Text="Button Wait Time (ms)" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="FlyoutButtonWaitTimeDescText" Text="Hardware debounce delay after clicking buttons before updating monitor" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Slider x:Name="FlyoutButtonDelaySlider" Minimum="100" Maximum="3000" StepFrequency="50" Width="160" VerticalAlignment="Center"/>
                                        <NumberBox x:Name="FlyoutButtonDelayNumberBox" Minimum="100" Maximum="3000" Width="90" SpinButtonPlacementMode="Hidden" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- SECTION: ACCENT COLOR -->
                            <TextBlock x:Name="FlyoutAccentSectionTitle" Text="Accent Color" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,6"/>

                            <!-- Use Windows Accent Color (Flyout) -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE790;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="FlyoutUseWindowsAccentTitleText" Text="Use Windows Accent Color" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="FlyoutUseWindowsAccentDescText" Text="Apply system accent color to the flyout slider filled track" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="FlyoutUseWindowsAccentStatusText" Text="On" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <ToggleSwitch x:Name="FlyoutUseWindowsAccentToggle" MinWidth="0" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Custom Accent Color (Flyout) -->
                            <Border x:Name="FlyoutAccentColorCard" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,12,16,12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE790;" FontSize="16" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="FlyoutCustomAccentTitleText" Text="Custom Accent Color" FontSize="14" FontWeight="Normal"/>
                                        <TextBlock x:Name="FlyoutCustomAccentDescText" Text="Fill color for flyout slider track (configured when Windows accent is off)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button x:Name="FlyoutAccentColorPickerButton" Padding="0" Width="32" Height="32" CornerRadius="4" ToolTipService.ToolTip="Choose color">
                                            <Border x:Name="FlyoutAccentColorPreview" Width="24" Height="24" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                            <Button.Flyout>
                                                <Flyout Placement="Bottom">
                                                    <ColorPicker x:Name="FlyoutAccentColorPicker" IsAlphaEnabled="False" IsColorSpectrumVisible="True" IsColorChannelTextInputVisible="False"/>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <TextBox x:Name="FlyoutAccentColorTextBox" Width="95" VerticalAlignment="Center" MaxLength="9"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </StackPanel>

                        <!-- ========================================== -->
                        <!-- SUBMENU 6: ABOUT                           -->
                        <!-- ========================================== -->
                        <StackPanel x:Name="AboutPanel" Visibility="Collapsed" Spacing="0">
                            <StackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="20"/>
                                </TransitionCollection>
                            </StackPanel.ChildrenTransitions>

                            <!-- Page Title & Header Banner -->
                            <Grid Padding="4,4,4,12" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE946;" FontSize="32" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="AboutHeaderTitle" Text="About ClickBrightness" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="AboutHeaderSubtitle" Text="Lightweight, modern Windows 11 DDC/CI monitor brightness utility" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- App Info Card with Real Application Icon -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,14,16,14" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="AboutAppIconImage" Width="48" Height="48" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="AboutAppNameText" Text="ClickBrightness" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AboutVersionText" Text="Version 1.0.5 (x64 Release)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="AboutAppTypeText" Text="Native WinUI 3 / Windows App SDK 2.6 Desktop Application" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="AboutCopyrightText" Text="Copyright (C) 2026 andris155" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Description Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,14,16,14" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE946;" FontSize="18" Width="24" Height="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="AboutDescTitleText" Text="Description" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AboutDescContentText" Text="A modern, lightweight Windows 11 utility for controlling hardware monitor brightness via DDC/CI (VCP code 0x10). Supports on-screen display (OSD), system tray live indicator with mouse wheel stepping, and a smooth flyout slider." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- License & Open Source Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="16,14,16,14" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8D7;" FontSize="18" Width="24" Height="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="AboutLicenseTitleText" Text="License" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AboutLicenseContentText" Text="Free and Open Source under the MIT License." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>


                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </NavigationView.Content>
        </NavigationView>

    </Grid>
</Window>
